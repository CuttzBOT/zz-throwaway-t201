#!/usr/bin/env bash
# Sets or deletes one app secret in this repo (ADR-014). Needs only bash, git and age.
#   ./set-secret NAME [--env staging] [--container NAME]
#   ./set-secret NAME --delete [--env staging] [--container NAME]
# The value comes from a hidden prompt or from stdin, never from an argument (arguments
# reach shell history and the process list). It is encrypted with keys/<env>.pub, and
# only that one file is committed and pushed. Written for bash 3.2 (macOS) and Git Bash.
set -u
umask 077

die() { echo "set-secret: $*" >&2; exit 1; }
usage() { echo "usage: ./set-secret NAME [--delete] [--env prod|staging] [--container NAME]" >&2; exit 2; }

name='' env=prod container='' delete=0
while [ $# -gt 0 ]; do
  case $1 in
  --delete) delete=1 ;;
  --env | --container)
    [ $# -ge 2 ] || usage
    if [ "$1" = --env ]; then env=$2; else container=$2; fi
    shift ;;
  --env=*) env=${1#--env=} ;;
  --container=*) container=${1#--container=} ;;
  -h | --help) usage ;;
  -*) usage ;;
  *)
    [ -z "$name" ] || die "one name only. The value is never an argument: type it at the prompt or pipe it in."
    name=$1 ;;
  esac
  shift
done
[ -n "$name" ] || usage
[[ $name =~ ^[A-Z][A-Z0-9_]*$ ]] || die "the name must be capital letters, digits and _, starting with a letter."
[ "$env" = prod ] || [ "$env" = staging ] || die "--env must be prod or staging."
if [ -n "$container" ]; then
  [[ $container =~ ^[a-z][a-z0-9-]*$ ]] || die "the container must be lowercase letters, digits and -."
fi

command -v git >/dev/null 2>&1 || die "git is not installed."
if ! command -v age >/dev/null 2>&1; then
  die "age is not installed. Install it: macOS 'brew install age'; Debian or Ubuntu 'sudo apt install age'; AlmaLinux or Fedora 'sudo dnf install age'; Windows 'scoop install age' or 'winget install FiloSottile.age', then use Git Bash."
fi

cd "$(dirname "$0")" || die "cannot enter the script's folder."
[ -z "$(git rev-parse --show-prefix 2>/dev/null)" ] && git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
  die "run this from the top of the secrets repo's clone."

git pull -q --ff-only || die "git pull failed. Fix that, then run again."

pubfile=keys/$env.pub
[ -f "$pubfile" ] || die "$pubfile is missing; the stack's keys are not set up."
IFS= read -r pub <"$pubfile"
[[ $pub =~ ^age1[a-z0-9]+$ ]] || die "$pubfile does not hold an age public key."

if [ -z "$container" ]; then
  found=''
  for d in prod/* staging/*; do
    [ -d "$d" ] || continue
    c=${d#*/}
    case " $found " in *" $c "*) ;; *) found="$found $c" ;; esac
  done
  set -- $found
  case $# in
  1) container=$1 ;;
  0) die "this stack has no secrets yet, so name the container: --container NAME." ;;
  *) die "this stack has more than one container ($found). Pick one: --container NAME." ;;
  esac
fi

file=$env/$container/$name.age
label="$name ($env/$container)"

if [ "$delete" = 1 ]; then
  git ls-files --error-unmatch -- "$file" >/dev/null 2>&1 || die "$file is not in the repo."
  git rm -q -- "$file" || die "git rm failed."
  git commit -q -m "Delete $label" -- "$file" || die "git commit failed."
else
  if [ -t 0 ]; then
    IFS= read -r -s -p "Value for $name (hidden): " value || die "no value read."
    echo >&2
    IFS= read -r -s -p "Again: " again || die "no value read."
    echo >&2
    [ "$value" = "$again" ] || die "the two values differ. Nothing changed."
    unset again
  else
    value=$(cat)
  fi
  [ -n "$value" ] || die "the value is empty. To remove a secret, use --delete."
  size=$(printf '%s' "$value" | wc -c | tr -d ' ')
  [ "$size" -le 65536 ] || die "the value is $size bytes; the limit is 65536."
  mkdir -p "$env/$container" || die "cannot make $env/$container."
  tmp=$file.tmp.$$
  trap 'rm -f "$tmp"' EXIT
  printf '%s' "$value" | age -r "$pub" -o "$tmp" || die "age failed. Nothing changed."
  unset value
  mv -f "$tmp" "$file" || die "cannot write $file."
  git add -- "$file" || die "git add failed."
  git commit -q -m "Set $label" -- "$file" || die "git commit failed."
fi

if ! git push -q 2>/dev/null; then
  git pull -q --rebase && git push -q ||
    die "committed here, but the push failed. Fix access or the network, then run: git push"
fi
echo "ok: $label $([ "$delete" = 1 ] && echo deleted || echo set). The app has it within about 5 minutes."
